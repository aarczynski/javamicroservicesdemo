            "uid": "prometheus"
          },
          "expr": "kube_pod_info",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(namespace|pod|node|host_ip)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "node": 2,
              "host_ip": 3
            },
            "renameByName": {
              "host_ip": "Node IP"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "node",
            "desc": false
          }
        ]
      }
    },
