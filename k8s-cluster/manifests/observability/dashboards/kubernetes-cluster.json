    {
      "id": 19,
      "type": "timeseries",
      "title": "CPU Limits Commitment by Node (%)",
      "description": "Sum of container CPU limits scheduled on the node, as a percentage of the node's allocatable CPU. Over 100% means pods could be throttled if they all hit their limit at once — informational, not an alarm by itself (unlike memory overcommit, CPU limits only throttle, they don't OOM-kill).",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_resource_limits{resource=\"cpu\"}) by (node) / on(node) sum(kube_node_status_allocatable{resource=\"cpu\"}) by (node) * 100",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
