        },
        "definition": "label_values(http_server_request_duration_seconds_count{job=~\"app-.*\"}, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Service",
        "multi": false,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=~\"app-.*\"}, job)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
