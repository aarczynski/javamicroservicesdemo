{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 5,
      "panels": [],
      "title": "Postgres — CPU & Memory",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Container CPU usage vs configured limit for $service's Postgres instance (postgres-candidates: 2 cores, postgres-job-offers: 3 cores as of 2026-09-11). Scoped to $service's namespace via a join against kube_deployment_status_replicas_ready, since app and its Postgres share one namespace.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/limit/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"postgres-.*\", container!=\"\", container!=\"POD\"}[5m])) by (namespace, pod) and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_pod_container_resource_limits{pod=~\"postgres-.*\", container=\"postgres\", resource=\"cpu\"} and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"}",
          "legendFormat": "{{pod}} limit",
          "refId": "B"
        }
      ],
      "title": "Postgres CPU Usage ($service, cores)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Container memory (working set) usage vs configured limit (2Gi) for $service's Postgres instance.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/limit/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_memory_working_set_bytes{pod=~\"postgres-.*\", container!=\"\", container!=\"POD\"}) by (namespace, pod) and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_pod_container_resource_limits{pod=~\"postgres-.*\", container=\"postgres\", resource=\"memory\"} and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"}",
          "legendFormat": "{{pod}} limit",
          "refId": "B"
        }
      ],
      "title": "Postgres Memory Usage ($service)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 8,
      "panels": [],
      "title": "Postgres — Hikari pool (app-side view)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "$service's view of its Postgres connection pool, summed across all replicas.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_active{job=\"$service\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_idle{job=\"$service\"})",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_pending{job=\"$service\"})",
          "legendFormat": "pending",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_max{job=\"$service\"})",
          "legendFormat": "max (all pools)",
          "refId": "D"
        }
      ],
      "title": "Hikari Pool ($service)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Requests queued waiting for a DB connection. The metric that exposed the job-offers Postgres CPU bottleneck during the 2026-09-11 capacity tests (climbed to ~191 at 1000 RPS).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_pending{job=\"$service\"})",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "title": "Pending Connections ($service)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 12,
      "panels": [],
      "title": "Postgres — Disk I/O (per db node)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Fraction of time the disk had at least one I/O in flight, on the node hosting $service's Postgres (nvme0n1). Used in the 2026-09-11 capacity investigation to rule out disk as the bottleneck (sat at 0.1-0.7%).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(node_disk_io_time_seconds_total{device=\"nvme0n1\"}[5m])) by (node) and on(node) (kube_pod_info{pod=~\"postgres-.*\"} and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Disk Busy Time — $service's DB Node (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Disk read/write throughput on the node hosting $service's Postgres (nvme0n1).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 14,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(node_disk_read_bytes_total{device=\"nvme0n1\"}[5m])) by (node) and on(node) (kube_pod_info{pod=~\"postgres-.*\"} and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"})",
          "legendFormat": "{{node}} read",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(node_disk_written_bytes_total{device=\"nvme0n1\"}[5m])) by (node) and on(node) (kube_pod_info{pod=~\"postgres-.*\"} and on(namespace) kube_deployment_status_replicas_ready{deployment=\"$service\"})",
          "legendFormat": "{{node}} write",
          "refId": "B"
        }
      ],
      "title": "Disk Read/Write Throughput — $service's DB Node",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "microservices",
    "postgres"
  ],
  "templating": {
    "list": [
      {
        "current": {},
